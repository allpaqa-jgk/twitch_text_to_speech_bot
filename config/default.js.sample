  RATE_ENGLISH: 150,
  RATE_JAPANESE: 200,

  // for TTS_MODE: CloudTTS
  BILINGAL_MODE: false,

  // TTS Engine for primary text
  // Options: "COEIROINK" | "VOICEVOX" | "PIPER" | "KOKORO" | "Mac"
  TTS_ENGINE: "COEIROINK",
  // TTS_ENGINE: "VOICEVOX",
  // TTS_ENGINE: "PIPER",
  // TTS_ENGINE: "KOKORO",
  // TTS_ENGINE: "Mac",

  // Foreign language mode:
  // "KATAKANA": 外国語（英語・ロシア語・スペイン語等）を自然な発音カタカナに変換して読む（推奨）
  // "NATIVE": 英語音声エンジン等でネイティブ発音で読む
  // "IGNORE": 外国語は読み飛ばす
  FOREIGN_LANGUAGE_MODE: "KATAKANA",

  // English TTS Engine (FOREIGN_LANGUAGE_MODE: "NATIVE" 時に使用)
