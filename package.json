{
  "name": "twitch_text_to_speech_bot",
  "version": "2.8.0",
  "description": "Text to Speech bot for Twitch with COEIROINK, Kokoro, Piper, VOICEVOX, and macOS say support",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "auth": "bun run scripts/auth.ts",
    "speakers": "bun run src/index.ts speakers",
    "demo": "bun run src/index.ts demo",
    "test": "cd src && bun test",
    "build": "cd src && bun run build",
    "package": "bun run scripts/build_package.ts",
    "package:mac-arm64": "bun run scripts/build_package.ts mac-arm64",
    "package:windows-x64": "bun run scripts/build_package.ts windows-x64",
    "package:linux-x64": "bun run scripts/build_package.ts linux-x64"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allpaqa-org/twitch_text_to_speech_bot"
  },
  "workspaces": [
    "src"
  ],
  "dependencies": {
    "@allpaqa/multilingual-katakana": "^0.5.0"
  }
}
