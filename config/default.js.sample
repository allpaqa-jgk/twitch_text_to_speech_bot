  TTS_MODE: "Mac",

  /// //////////////////
  //    COMMANDS     //
  /// //////////////////

  // enable comment remember function
  COMMENT_REMEMVER_AVAILABLE: true,

  // custom command for remember and forget
  // e.g.)
  // COMMENT_REMEMVER_COMMAND = 'xxx'
  // xxx is command for remember comment convert pattern
  // and xxxU is command for remember username convert pattern
  COMMENT_REMEMVER_COMMAND: "remember",
  COMMENT_FORGET_COMMAND: "forget",

  /// //////////////////
  //       TTS       //
  /// //////////////////

  // Common
  ENABLE_TTS: true,
  READ_USERNAME: true,
  USE_SIMPLE_NAME: true,
