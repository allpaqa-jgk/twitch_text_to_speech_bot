  ENGLISH_TTS_ENGINE: "KOKORO",
  KOKORO_ENGLISH_VOICE: "af_heart", // ElevenLabs並みの高音質英語ボイス

  // for COEIROINK
  COEIROINK_HOST: "127.0.0.1",
  COEIROINK_PORT: 50032,
  COEIROINK_STYLE_ID: 0, // 利用したいキャラクターのスタイルID (COEIROINKエディタ等で確認可能)
  COEIROINK_SPEED_SCALE: 1.0,
  COEIROINK_VOLUME_SCALE: 1.0,

  // for VOICEVOX (also used as fallback if TTS_ENGINE is not set)
